# 复制为 .env 并填入真实值

# 数据库(SQLite,路径相对于 prisma/ 目录)
DATABASE_URL="file:./dev.db"

# Auth.js 会话签名密钥(生成:openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# AI Provider 密钥(按需配置其一即可,留空的 Provider 视为未启用)
OPENAI_API_KEY=
# OpenAI 兼容网关地址(可选,key 非官方 OpenAI key 时配置,如 http://localhost:8000/v1)
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=

# 默认使用的 Provider 与模型(可选,默认取第一个已配置的 Provider)
# AI_PROVIDER=openai
# AI_DEFAULT_MODEL=gpt-4o-mini

# 用户项目工作区根目录(Agent 生成的毕业设计项目存放位置)
WORKSPACE_ROOT=./.workspace

# sql2er CLI(Chen 模型 ER 图生成器;安装:npx skills add ystemsrx/sql_to_er)
# 留空则 ER 页使用内置渲染
SQL2ER_AGENT=

# ---- Codex 完整开发 · 交付闸门（docs/DELIVERY_GATE.md）----
# 默认模型（批量模块生成）；规划与修复可单独指定更强模型，留空则沿用默认
# GS_CODEX_MODEL=deepseek-flash
# GS_CODEX_MODEL_PLAN=
# GS_CODEX_MODEL_REPAIR=
# 每个闸门最多修复轮数（同一失败指纹重复会提前停止），默认 3
# GS_GATE_MAX_REPAIRS=3
# 模块闸门层级：full（默认，每模块 compose 启动+冒烟+截图）| fast（只构建+测试，最后统一 full）
# GS_GATE_MODULE_TIER=full
# 闸门构建容器网络（需要访问 Maven/npm/PyPI），默认 bridge
# GS_GATE_NETWORK=bridge
# 国内镜像（可选）
# GS_GATE_MAVEN_MIRROR=https://maven.aliyun.com/repository/public
# GS_GATE_NPM_REGISTRY=https://registry.npmmirror.com
# GS_GATE_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# 工具链镜像覆盖（可选）
# GS_GATE_NODE_IMAGE=node:22-bookworm
# GS_GATE_MAVEN_IMAGE=maven:3.9-eclipse-temurin-17
# GS_GATE_PYTHON_IMAGE=python:3.12-slim
# GS_GATE_PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.49.1-noble
# 带 JDK 的 Codex worker（docker/codex-worker-java）
# GS_CODEX_WORKER_IMAGE_JAVA=gs-codex-worker-java:0.150.1
